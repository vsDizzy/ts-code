// Client tsconfig: used by the editor, and by the service worker to transpile
// this page's .ts/.tsx (it reads compilerOptions; see ts-code/runtime/typescript.js).
{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    // false: imports have no extension; the SW resolves ./lib to lib.ts, then
    // lib.tsx (no index.ts). true: imports must name the .ts/.tsx file.
    "allowImportingTsExtensions": false,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["app"]
}
